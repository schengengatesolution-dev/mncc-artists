# Neon Postgres (required on Vercel). Prisma uses schema "mncc".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional offline SQLite: copy prisma/schema.sqlite.prisma → schema.prisma
# DATABASE_URL="file:./dev.db"

ADMIN_PASSWORD="mncc-admin-demo"
AUTH_SECRET="change-me-to-a-long-random-string"

# Strongly recommended on Vercel: create a Blob store in the project Storage tab.
# Vercel injects this automatically — do not commit real tokens.
# Without it, photos ≤1.5MB / resume ≤4MB use data-URL fallback (large uploads fail).
# BLOB_READ_WRITE_TOKEN=""
