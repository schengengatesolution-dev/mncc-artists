# Postgres (Neon) — required for Vercel; also works locally
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional offline local: use prisma/schema.sqlite.prisma as schema.prisma
# DATABASE_URL="file:./dev.db"

ADMIN_PASSWORD="mncc-admin-demo"
AUTH_SECRET="change-me-auth-secret"

# Optional: Vercel Blob for durable uploads on Vercel
# BLOB_READ_WRITE_TOKEN=""
