generator client {
  provider = "prisma-client-js"
}

// Offline local SQLite — copy over schema.prisma and set DATABASE_URL=file:./dev.db
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Artist {
  id                 String   @id @default(cuid())
  slug               String   @unique
  fullLegalName      String
  stageName          String?
  email              String
  phone              String
  nationality        String
  actTypes           String // JSON array
  actTitle           String
  bioEn              String
  bioMn              String?
  videoUrls          String // JSON array — Google Drive file/folder share links
  videoFileUrls      String   @default("[]")
  photoUrls          String // JSON array — first is headshot (optional if photosDriveUrl set)
  photosDriveUrl     String? // Google Drive folder for photo pack
  resumeUrl          String?
  resumeDriveUrl     String? // Google Drive link to CV
  yearsExperience    Int?
  availabilityWindow String?
  preferredRegions   String   @default("[]")
  desiredFeeNote     String?
  techRider          String?
  agency             String?
  consent            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
